{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "A full-stack task management application built with Node.js, Express, and SQLite.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "test": "node --test server.test.js"
    
  },
  "overrides": {
    "sqlite3": "$sqlite3",
